---
/* Icônes fonctionnelles en trait fin, toujours décoratives (aria-hidden) : le texte voisin porte le sens. */
interface Props {
  nom: 'fleche' | 'externe' | 'chevron' | 'menu' | 'fermer' | 'copier' | 'recherche';
  taille?: number;
  class?: string;
}
const { nom, taille = 16, class: classe } = Astro.props;
const chemins: Record<Props['nom'], string> = {
  fleche: 'M5 12h14M13 6l6 6-6 6',
  externe: 'M7 17L17 7M9 7h8v8',
  chevron: 'M6 9l6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  fermer: 'M6 6l12 12M18 6L6 18',
  copier: 'M9 9h11v11H9zM5 15V4h11',
  recherche: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-3.5-3.5',
};
---

<svg
  class={classe}
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={chemins[nom]}></path></svg
>
