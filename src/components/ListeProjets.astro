---
import type { CollectionEntry } from 'astro:content';
import { t, lien } from '../i18n/ui';
import { slug, periode } from '../lib/contenu';

interface Props {
  lang: string;
  projets: CollectionEntry<'projets'>[];
}
const { lang, projets } = Astro.props;
---

<ul class="projets">
  {
    projets.map((p) => {
      const aUnePage = Boolean(p.body?.trim()) || Boolean(p.data.co_chercheurs);
      return (
        <li class="projet">
          <span class="projet__annees ui">{periode(p.data.debut, p.data.fin)}</span>
          <div>
            <h3 class="projet__titre">
              {aUnePage ? <a href={lien(lang, `recherche/${slug(p.id)}`)}>{p.data.titre}</a> : p.data.titre}
            </h3>
            <p class="projet__meta">
              {p.data.financement}
              {p.data.chercheur_principal && (
                <>
                  <br />
                  {t(lang, 'projets.chercheur_principal')} : {p.data.chercheur_principal}
                </>
              )}
            </p>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .projets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projet {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--pas-4);
    padding-block: var(--pas-5);
    border-top: 1px solid var(--trait);
  }
  .projet__annees {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--epinette);
    padding-top: 0.15rem;
  }
  .projet__titre {
    font-size: 1.15rem;
    font-weight: 550;
    margin-bottom: var(--pas-2);
    max-width: 48rem;
  }
  .projet__titre a {
    color: var(--sapin);
    text-decoration-color: var(--trait);
  }
  .projet__titre a:hover {
    text-decoration-color: var(--epinette);
  }
  .projet__meta {
    margin: 0;
    color: var(--gris-mousse);
    font-size: 1rem;
    max-width: 48rem;
  }
  @media (max-width: 40rem) {
    .projet {
      grid-template-columns: 1fr;
      gap: var(--pas-1);
    }
  }
</style>
