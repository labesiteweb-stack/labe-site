---
import Base from '../../../layouts/Base.astro';
import ListeProjets from '../../../components/ListeProjets.astro';
import { LANGUES, t } from '../../../i18n/ui';
import { parLangue, enCours } from '../../../lib/contenu';

export function getStaticPaths() {
  return LANGUES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const tous = (await parLangue('projets', lang)).sort(
  (a, b) => b.data.fin - a.data.fin || b.data.debut - a.data.debut || a.data.titre.localeCompare(b.data.titre),
);

const statuts = [
  { id: 'en-cours', titre: t(lang, 'projets.en_cours'), liste: tous.filter((p) => enCours(p.data.fin)) },
  { id: 'termines', titre: t(lang, 'projets.termines'), liste: tous.filter((p) => !enCours(p.data.fin)) },
].map((s) => ({
  ...s,
  diriges: s.liste.filter((p) => p.data.role !== 'co-chercheuse'),
  contribue: s.liste.filter((p) => p.data.role === 'co-chercheuse'),
}));
---

<Base lang={lang} titre={t(lang, 'projets.titre')} section="recherche">
  <header class="entete-page cadre">
    <h1>{t(lang, 'projets.titre')}</h1>
    <p class="chapo">{t(lang, 'projets.intro')}</p>
    <nav class="sommaire ui" aria-label={t(lang, 'projets.titre')}>
      {statuts.map((s) => <a href={`#${s.id}`}>{s.titre} <span>({s.liste.length})</span></a>)}
    </nav>
  </header>

  {
    statuts.map((s) => (
      <section class="cadre statut" id={s.id} aria-labelledby={`${s.id}-titre`}>
        <h2 id={`${s.id}-titre`}>{s.titre}</h2>
        {s.diriges.length > 0 && (
          <div class="groupe">
            <h3 class="groupe__titre">{t(lang, 'projets.principale')}</h3>
            <ListeProjets lang={lang} projets={s.diriges} />
          </div>
        )}
        {s.contribue.length > 0 && (
          <div class="groupe">
            <h3 class="groupe__titre">{t(lang, 'projets.contribue')}</h3>
            <ListeProjets lang={lang} projets={s.contribue} />
          </div>
        )}
      </section>
    ))
  }
</Base>

<style>
  .sommaire {
    display: flex;
    gap: var(--pas-5);
    margin-top: var(--pas-5);
    font-weight: 600;
  }
  .sommaire span {
    color: var(--gris-mousse);
    font-weight: 400;
  }
  .statut {
    padding-top: var(--pas-7);
    scroll-margin-top: var(--pas-4);
  }
  .groupe {
    margin-top: var(--pas-6);
  }
  .groupe__titre {
    font-size: 1.05rem;
    color: var(--gris-mousse);
    font-weight: 550;
    margin-bottom: var(--pas-3);
  }
</style>
