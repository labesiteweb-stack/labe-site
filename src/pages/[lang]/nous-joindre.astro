---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { LANGUES, t, lien } from '../../i18n/ui';
import { paragraphes } from '../../lib/contenu';
import AValider from '../../components/AValider.astro';
import Icone from '../../components/Icone.astro';

export function getStaticPaths() {
  return LANGUES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const page = (await getEntry('pages', `${lang}/contact`))!.data;
const site = (await getEntry('reglages', 'site'))!.data;
const externe = (h: string) => /^https?:/.test(h);
---

<Base lang={lang} titre={page.titre} description={page.accroche} section="contact">
  <header class="cadre entete-page">
    <nav class="fil-ariane" aria-label={t(lang, 'nav.fil')}>
      <ol>
        <li><a href={lien(lang)}>{t(lang, 'nav.accueil')}</a></li>
        <li aria-current="page">{page.titre}</li>
      </ol>
    </nav>
    <h1>{page.titre}</h1>
    {page.accroche && <p class="chapo">{page.accroche}</p>}
  </header>

  <div class="cadre contact">
    <ul class="voies">
      {
        page.sections.map((s) => (
          <li class="voie">
            <h2>{s.titre}</h2>
            {paragraphes(s.texte).map((p) => (
              <p>{p}</p>
            ))}
            {s.bouton_texte && s.bouton_lien && (
              <a class="lien-fleche" href={s.bouton_lien} data-externe={externe(s.bouton_lien) ? '' : undefined}>
                {s.bouton_texte}
                {externe(s.bouton_lien) && <span class="visuellement-cache">{t(lang, 'lien.externe')}</span>}
                <Icone nom={externe(s.bouton_lien) ? 'externe' : 'fleche'} />
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <aside class="coordonnees" id="coordonnees" aria-labelledby="coord-titre">
      <h2 id="coord-titre">
        {t(lang, 'contact.coordonnees')}
        <AValider lang={lang} note="Courriel et téléphone du labo, adresse à afficher" />
      </h2>
      <dl>
        {
          site.courriel && (
            <div>
              <dt>{t(lang, 'contact.courriel')}</dt>
              <dd>
                <a href={`mailto:${site.courriel}`}>{site.courriel}</a>
              </dd>
            </div>
          )
        }
        {
          site.telephone && (
            <div>
              <dt>{t(lang, 'contact.telephone')}</dt>
              <dd>{site.telephone}</dd>
            </div>
          )
        }
        {
          site.adresses.map((a) => (
            <div>
              <dt>{a.nom}</dt>
              <dd>
                {a.lignes.map((l, i) => (
                  <>
                    {i > 0 && <br />}
                    {l}
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pas-5);
    row-gap: var(--pas-6);
    align-items: start;
  }
  .voies {
    grid-column: span 7;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--pas-5);
  }
  .voie {
    padding: var(--pas-6);
    border-radius: var(--rayon);
    background: var(--c-surface);
  }
  .voie h2 {
    font-size: 1.75rem;
    margin-bottom: var(--pas-3);
  }
  .voie p {
    margin-bottom: var(--pas-3);
    color: var(--c-texte-2);
  }
  .coordonnees {
    grid-column: 9 / span 4;
    position: sticky;
    top: var(--pas-6);
    padding: var(--pas-6);
    border-radius: var(--rayon);
    background: var(--c-surface-2);
  }
  .coordonnees h2 {
    font-size: 1.75rem;
  }
  .coordonnees dl {
    margin: 0;
  }
  .coordonnees dl > div + div {
    margin-top: var(--pas-4);
  }
  .coordonnees dt {
    font-weight: 600;
    color: var(--c-titre);
  }
  .coordonnees dd {
    margin: var(--pas-1) 0 0;
    line-height: 1.6;
  }
  @media (max-width: 54em) {
    .voies,
    .coordonnees {
      grid-column: 1 / -1;
    }
    .coordonnees {
      position: static;
    }
  }
</style>
