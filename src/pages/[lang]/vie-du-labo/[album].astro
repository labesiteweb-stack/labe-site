---
import Base from '../../../layouts/Base.astro';
import { LANGUES, t, lien } from '../../../i18n/ui';
import { publiees } from '../../../lib/contenu';
import AValider from '../../../components/AValider.astro';

export async function getStaticPaths() {
  const albums = await publiees('galerie');
  return LANGUES.flatMap((lang) => albums.map((a) => ({ params: { lang, album: a.id }, props: { a } })));
}

const { lang } = Astro.params;
const { a } = Astro.props;
const d = a.data;
const quand =
  d.date_texte ??
  (d.date ? d.date.toLocaleDateString(lang === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '');
---

<Base lang={lang} titre={d.titre} description={d.description} section="labo">
  <header class="cadre entete-page">
    <nav class="fil-ariane" aria-label={t(lang, 'nav.fil')}>
      <ol>
        <li><a href={lien(lang)}>{t(lang, 'nav.accueil')}</a></li>
        <li><a href={lien(lang, 'vie-du-labo')}>{t(lang, 'galerie.titre')}</a></li>
        <li aria-current="page">{d.titre}</li>
      </ol>
    </nav>
    {quand && <p class="etiquette">{quand}</p>}
    <h1>{d.titre}<AValider si={d.a_valider} lang={lang} /></h1>
    {d.description && <p class="chapo">{d.description}</p>}
  </header>

  <ul class="cadre photos" data-photos>
    {
      d.photos.map((p, i) => (
        <li>
          <a href={p} data-index={i}>
            <img src={p} alt={`${d.titre}, photo ${i + 1} de ${d.photos.length}`} loading={i < 6 ? 'eager' : 'lazy'} />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="visionneuse" data-visionneuse aria-label={d.titre}>
    <img data-grande alt="" />
    <div class="visionneuse__commandes">
      <button type="button" data-prec>{t(lang, 'galerie.precedente')}</button>
      <span data-compteur></span>
      <button type="button" data-suiv>{t(lang, 'galerie.suivante')}</button>
      <button type="button" data-fermer>{t(lang, 'galerie.fermer')}</button>
    </div>
  </dialog>
</Base>

<script>
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('[data-photos] a')];
  const dlg = document.querySelector<HTMLDialogElement>('[data-visionneuse]');
  if (dlg && liens.length) {
    const img = dlg.querySelector<HTMLImageElement>('[data-grande]')!;
    const compteur = dlg.querySelector<HTMLElement>('[data-compteur]')!;
    let i = 0;
    const montrer = (n: number) => {
      i = (n + liens.length) % liens.length;
      img.src = liens[i].href;
      img.alt = liens[i].querySelector('img')?.alt ?? '';
      compteur.textContent = `${i + 1} / ${liens.length}`;
    };
    liens.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        montrer(n);
        dlg.showModal();
      }),
    );
    dlg.querySelector('[data-prec]')!.addEventListener('click', () => montrer(i - 1));
    dlg.querySelector('[data-suiv]')!.addEventListener('click', () => montrer(i + 1));
    dlg.querySelector('[data-fermer]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') montrer(i - 1);
      if (e.key === 'ArrowRight') montrer(i + 1);
    });
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>

<style>
  .photos {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--pas-4);
  }
  .photos a {
    display: block;
    border-radius: var(--rayon);
  }
  .photos img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--rayon);
    transition: opacity 150ms ease;
  }
  .photos a:hover img {
    opacity: 0.88;
  }
  .visionneuse {
    border: 0;
    padding: 0;
    max-width: min(92vw, 1600px);
    max-height: 92vh;
    border-radius: var(--rayon);
    background: #0f1f16;
  }
  .visionneuse::backdrop {
    background: rgba(10, 20, 14, 0.9);
  }
  .visionneuse img {
    max-height: calc(92vh - 4.5rem);
    width: auto;
    margin-inline: auto;
  }
  .visionneuse__commandes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--pas-3);
    padding: var(--pas-3);
    color: #ffffff;
    font-size: 0.95rem;
  }
  .visionneuse__commandes button {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--rayon-petit);
    background: none;
    color: #ffffff;
    font: inherit;
    cursor: pointer;
  }
  .visionneuse__commandes button:focus-visible {
    outline-color: #f2b33d;
  }
</style>
