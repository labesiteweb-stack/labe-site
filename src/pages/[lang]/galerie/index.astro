---
import Base from '../../../layouts/Base.astro';
import { LANGUES, t, lien } from '../../../i18n/ui';
import { publiees } from '../../../lib/contenu';

export function getStaticPaths() {
  return LANGUES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const albums = (await publiees('galerie')).sort(
  (a, b) => (b.data.date?.getTime() ?? -Infinity) - (a.data.date?.getTime() ?? -Infinity),
);
const quand = (d?: Date, texte?: string) =>
  texte ?? (d ? d.toLocaleDateString(lang === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: 'long', timeZone: 'UTC' }) : '');
---

<Base lang={lang} titre={t(lang, 'galerie.titre')} section="galerie">
  <header class="entete-page cadre">
    <h1>{t(lang, 'galerie.titre')}</h1>
    <p class="chapo">{t(lang, 'galerie.intro')}</p>
  </header>

  <ul class="cadre albums">
    {
      albums.map((a) => (
        <li>
          <a class="album" href={lien(lang, `galerie/${a.id}`)}>
            <img src={a.data.couverture ?? a.data.photos[0]} alt="" loading="lazy" />
            <span class="album__titre">{a.data.titre}</span>
            <span class="album__meta ui">
              {quand(a.data.date, a.data.date_texte)}
              {quand(a.data.date, a.data.date_texte) && ', '}
              {a.data.photos.length} {a.data.photos.length > 1 ? t(lang, 'galerie.photos') : t(lang, 'galerie.photo')}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .albums {
    list-style: none;
    padding-top: var(--pas-3);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--pas-7) var(--pas-6);
  }
  .album {
    display: grid;
    gap: var(--pas-2);
    text-decoration: none;
    color: var(--encre);
  }
  .album img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: var(--pas-2);
  }
  .album__titre {
    font-family: var(--titre);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--sapin);
    line-height: 1.25;
  }
  .album:hover .album__titre {
    text-decoration: underline;
    text-decoration-color: var(--epinette);
    text-underline-offset: 0.2em;
  }
  .album__meta {
    font-size: 0.92rem;
    color: var(--gris-mousse);
  }
</style>
