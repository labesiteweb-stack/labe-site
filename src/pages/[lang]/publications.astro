---
import Base from '../../layouts/Base.astro';
import { LANGUES, t, lien } from '../../i18n/ui';
import { publiees, surligner, nomsAsurligner, langueTitre } from '../../lib/contenu';
import AValider from '../../components/AValider.astro';
import Icone from '../../components/Icone.astro';

export function getStaticPaths() {
  return LANGUES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const noms = await nomsAsurligner(lang);
const pubs = (await publiees('publications')).sort(
  (a, b) => b.data.annee - a.data.annee || a.data.type.localeCompare(b.data.type) || a.data.auteurs.localeCompare(b.data.auteurs),
);
const annees = [...new Set(pubs.map((p) => p.data.annee))];
// Le site ne montre que les publications parues (décision du labo, 28 oct. 2026) : pas d'abrégés ni d'articles soumis.
const types = (['article', 'transfert', 'livre', 'rapport', 'formation'] as const).filter((ty) => pubs.some((p) => p.data.type === ty));
const compte = (type: string) => pubs.filter((p) => p.data.type === type).length;
const MAX = 10;

function auteurs(liste: string) {
  const tous = liste.split(/,\s*/).filter(Boolean);
  if (tous.length <= MAX + 1) return { court: surligner(liste, noms), reste: 0, dont: [] as string[], complet: '' };
  const restants = tous.slice(MAX).join(', ');
  const dont = [...surligner(restants, noms).matchAll(/class="auteur-[^"]+">([^<]+)</g)].map((m) => m[1]);
  return { court: surligner(tous.slice(0, MAX).join(', '), noms), reste: tous.length - MAX, dont, complet: surligner(liste, noms) };
}

const reference = (p: (typeof pubs)[number]) =>
  [
    `${p.data.auteurs.replace(/\.$/, '')}. (${p.data.annee}). ${p.data.titre.replace(/\.$/, '')}.`,
    p.data.source ? ` ${p.data.source}${p.data.details ? `, ${p.data.details}` : ''}.` : '',
    p.data.lien ? ` ${p.data.lien}` : '',
  ].join('');
---

<Base lang={lang} titre={t(lang, 'publications.titre')} description={t(lang, 'publications.intro')} section="publications">
  <header class="cadre entete-page tete">
    <div>
      <nav class="fil-ariane" aria-label={t(lang, 'nav.fil')}>
        <ol>
          <li><a href={lien(lang)}>{t(lang, 'nav.accueil')}</a></li>
          <li aria-current="page">{t(lang, 'publications.titre')}</li>
        </ol>
      </nav>
      <h1>{t(lang, 'publications.titre')}</h1>
      <p class="chapo">{t(lang, 'publications.intro')}</p>
    </div>
    <div class="champ tete__recherche" data-zone-recherche hidden>
      <label for="recherche">{t(lang, 'publications.recherche')}</label>
      <div class="recherche">
        <Icone nom="recherche" taille={18} />
        <input id="recherche" type="search" placeholder={t(lang, 'publications.recherche.aide')} data-recherche autocomplete="off" />
      </div>
    </div>
  </header>

  <div class="outils" data-outils>
    <div class="cadre outils__rang">
      <div class="filtres" role="group" aria-label="Type de publication" data-types hidden>
        <button class="filtre" type="button" aria-pressed="true" data-type="">{t(lang, 'publications.tous')} <span>{pubs.length}</span></button>
        {
          types
            .filter((ty) => compte(ty) > 0)
            .map((ty) => (
              <button class="filtre" type="button" aria-pressed="false" data-type={ty}>
                {t(lang, `typec.${ty}`)} <span>{compte(ty)}</span>
              </button>
            ))
        }
      </div>
      <nav class="annees" aria-label={t(lang, 'publications.aller')}>
        <span class="etiquette annees__libelle" aria-hidden="true">{t(lang, 'publications.annee')}</span>
        <ul>
          {
            annees.map((a) => (
              <li data-lien-annee={a}>
                <a href={`#annee-${a}`}>{a}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <p class="cadre vide" data-vide hidden>{t(lang, 'publications.aucun')}</p>
  <p class="visuellement-cache" aria-live="polite" data-annonce></p>

  {
    annees.map((a) => {
      const items = pubs.filter((p) => p.data.annee === a);
      return (
        <section class="cadre annee" id={`annee-${a}`} data-annee={a} aria-labelledby={`titre-${a}`}>
          <div class="annee__cote">
            <h2 id={`titre-${a}`}>{a}</h2>
            <p class="meta" data-compte>
              {items.length} {items.length > 1 ? t(lang, 'publications.plusieurs') : t(lang, 'publications.une')}
            </p>
          </div>
          <ol class="refs">
            {items.map((p) => {
              const d = p.data;
              const au = auteurs(d.auteurs);
              const langue = langueTitre(d.titre, d.langue);
              return (
                <li class="ref" data-ref data-type={d.type}>
                  <p class="ref__type">
                    <span class="etiquette">{t(lang, `type1.${d.type}`)}</span>
                    {d.source && (
                      <cite class="ref__source">
                        {d.source}
                        {d.details && `, ${d.details}`}
                      </cite>
                    )}
                    {d.statut && <span class="pastille pastille--lumiere">{d.statut}</span>}
                  </p>
                  <h3 class="ref__titre" lang={langue !== lang ? langue : undefined}>
                    {d.titre}
                  </h3>
                  <AValider si={d.a_valider} lang={lang} />
                  <p class="ref__auteurs">
                    {au.reste > 0 ? (
                      <>
                        <span data-court set:html={au.court} />
                        <span data-complet hidden set:html={au.complet} />{' '}
                        <button class="ref__plus" type="button" aria-expanded="false" data-plus>
                          et {au.reste} {au.reste > 1 ? t(lang, 'publications.autres') : t(lang, 'publications.autres_un')}
                          {au.dont.length > 0 && <>, {t(lang, 'publications.dont')} {au.dont.join(', ')}</>}
                        </button>
                      </>
                    ) : (
                      <span set:html={au.court} />
                    )}
                  </p>
                  <div class="ref__actions">
                    {d.lien && (
                      <a class="lien-fleche" href={d.lien} data-externe>
                        {d.type === 'article' || d.type === 'soumis' ? t(lang, 'publications.lire') : t(lang, 'publications.consulter')}
                        <span class="visuellement-cache">
                          {' '}
                          : {d.titre} {t(lang, 'lien.externe')}
                        </span>
                        <Icone nom="externe" taille={15} />
                      </a>
                    )}
                    <details class="ref__citer">
                      <summary>
                        {t(lang, 'publications.citer')}
                        <span class="visuellement-cache"> : {d.titre}</span>
                        <Icone nom="chevron" taille={14} />
                      </summary>
                      <div class="ref__citation">
                        <p lang={langue !== lang ? langue : undefined} data-citation>
                          {reference(p)}
                        </p>
                        <button class="bouton bouton--contour ref__copier" type="button" data-copier>
                          <Icone nom="copier" taille={15} />
                          <span data-texte-copier>{t(lang, 'publications.copier')}</span>
                        </button>
                      </div>
                    </details>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })
  }
</Base>

<script>
  const lesRefs = [...document.querySelectorAll<HTMLElement>('[data-ref]')];
  const annees = [...document.querySelectorAll<HTMLElement>('[data-annee]')];
  const champ = document.querySelector<HTMLInputElement>('[data-recherche]');
  const types = document.querySelector<HTMLElement>('[data-types]');
  const vide = document.querySelector<HTMLElement>('[data-vide]')!;
  const annonce = document.querySelector<HTMLElement>('[data-annonce]')!;
  const boutons = types ? [...types.querySelectorAll<HTMLButtonElement>('[data-type]')] : [];
  document.querySelector<HTMLElement>('[data-zone-recherche]')!.hidden = false;
  if (types) types.hidden = false;

  const normaliser = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const index = new Map(lesRefs.map((li) => [li, normaliser(li.textContent ?? '')]));
  let type = new URLSearchParams(location.search).get('type') ?? '';
  if (!boutons.some((b) => b.dataset.type === type)) type = '';

  const filtrer = () => {
    const q = normaliser(champ?.value.trim() ?? '');
    let total = 0;
    for (const section of annees) {
      let n = 0;
      for (const li of section.querySelectorAll<HTMLElement>('[data-ref]')) {
        const ok = (!type || li.dataset.type === type) && (!q || index.get(li)!.includes(q));
        li.hidden = !ok;
        if (ok) n++;
      }
      section.hidden = n === 0;
      const compte = section.querySelector('[data-compte]');
      if (compte) compte.textContent = `${n} publication${n > 1 ? 's' : ''}`;
      const lienAnnee = document.querySelector<HTMLElement>(`[data-lien-annee="${section.dataset.annee}"]`);
      if (lienAnnee) lienAnnee.hidden = n === 0;
      total += n;
    }
    vide.hidden = total > 0;
    annonce.textContent = `${total} publication${total > 1 ? 's' : ''}`;
    boutons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.type ?? '') === type)));
  };

  champ?.addEventListener('input', filtrer);
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      type = b.dataset.type ?? '';
      const url = new URL(location.href);
      if (type) url.searchParams.set('type', type);
      else url.searchParams.delete('type');
      history.replaceState(null, '', url);
      filtrer();
    }),
  );
  filtrer();

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-plus]')) {
    b.addEventListener('click', () => {
      const p = b.closest('p')!;
      p.querySelector<HTMLElement>('[data-court]')!.hidden = true;
      p.querySelector<HTMLElement>('[data-complet]')!.hidden = false;
      b.hidden = true;
    });
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copier]')) {
    b.addEventListener('click', async () => {
      const texte = b.parentElement!.querySelector('[data-citation]')!.textContent!.trim();
      const etiquette = b.querySelector('[data-texte-copier]')!;
      const avant = etiquette.textContent;
      try {
        await navigator.clipboard.writeText(texte);
        etiquette.textContent = 'Référence copiée';
        setTimeout(() => (etiquette.textContent = avant), 2000);
      } catch (e) {
        const sel = window.getSelection();
        const r = document.createRange();
        r.selectNodeContents(b.parentElement!.querySelector('[data-citation]')!);
        sel?.removeAllRanges();
        sel?.addRange(r);
      }
    });
  }
</script>

<style>
  .tete {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pas-5);
    row-gap: var(--pas-5);
    align-items: end;
  }
  .tete > div:first-child {
    grid-column: span 7;
  }
  .tete__recherche {
    grid-column: 9 / span 4;
  }
  .recherche {
    position: relative;
  }
  .recherche :global(svg) {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--c-texte-2);
  }
  .recherche input {
    padding-left: 2.75rem;
  }
  .outils {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--c-fond);
    border-block: 1px solid var(--c-trait);
  }
  .outils__rang {
    display: grid;
    gap: var(--pas-3);
    padding-block: var(--pas-3);
  }
  .annees {
    display: flex;
    align-items: center;
    gap: var(--pas-3);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .annees__libelle {
    margin: 0;
  }
  .annees ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--pas-1);
  }
  .annees a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    min-height: 2.5rem;
    border-radius: var(--rayon-petit);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .annees a:hover {
    background: var(--c-surface);
    text-decoration: underline;
  }
  .vide {
    padding-top: var(--pas-6);
  }
  .annee {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pas-5);
    padding-top: var(--pas-7);
    scroll-margin-top: 10.5rem;
  }
  .annee__cote {
    grid-column: span 2;
  }
  .annee__cote h2 {
    margin: 0 0 var(--pas-2);
    font-size: 2.75rem;
    line-height: 1;
    position: sticky;
    top: 10.5rem;
  }
  .refs {
    grid-column: 3 / span 10;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ref {
    padding-block: var(--pas-5);
    border-top: 1px solid var(--c-trait);
  }
  .ref__type {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pas-1) var(--pas-3);
    margin: 0 0 var(--pas-2);
  }
  .ref__type .etiquette {
    display: inline;
    margin: 0;
  }
  .ref__source {
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--c-texte-2);
  }
  .ref__titre {
    font-size: 1.2rem;
    line-height: 1.4;
    margin-bottom: var(--pas-2);
    max-width: 52rem;
  }
  .ref__auteurs {
    margin: 0 0 var(--pas-2);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c-texte-2);
    max-width: 52rem;
  }
  .ref__plus {
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-action);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .ref__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 var(--pas-6);
  }
  .ref__actions .lien-fleche {
    font-size: 0.9375rem;
  }
  .ref__citer {
    flex-basis: 100%;
  }
  .ref__actions .lien-fleche + .ref__citer {
    flex-basis: auto;
  }
  .ref__citer[open] {
    flex-basis: 100%;
  }
  .ref__citer summary {
    display: inline-flex;
    align-items: center;
    gap: var(--pas-2);
    min-height: 2.75rem;
    color: var(--c-action);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .ref__citer summary::-webkit-details-marker {
    display: none;
  }
  .ref__citer[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .ref__citation {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--pas-4);
    margin-top: var(--pas-2);
    padding: var(--pas-5);
    border-radius: var(--rayon);
    background: var(--c-surface);
  }
  .ref__citation p {
    flex: 1 1 30rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .ref__copier {
    min-height: 2.75rem;
    font-size: 0.9375rem;
    background: var(--c-fond);
  }
  @media (max-width: 54em) {
    .tete > div:first-child,
    .tete__recherche {
      grid-column: 1 / -1;
    }
    .annee {
      scroll-margin-top: 13rem;
    }
    .annee__cote,
    .refs {
      grid-column: 1 / -1;
    }
    .annee__cote {
      display: flex;
      align-items: baseline;
      gap: var(--pas-4);
      margin-bottom: var(--pas-3);
    }
    .annee__cote h2 {
      position: static;
      font-size: 2.25rem;
    }
    .outils {
      position: static;
    }
  }
</style>
