---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { LANGUES, t, lien } from '../../i18n/ui';
import { parLangue, APERCU } from '../../lib/contenu';
import Portrait from '../../components/Portrait.astro';
import AValider from '../../components/AValider.astro';
import Icone from '../../components/Icone.astro';

export function getStaticPaths() {
  return LANGUES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const tous = await parLangue('equipe', lang);
const ordreRole = ['direction', 'personnel', 'postdoc', 'doctorat', 'maitrise', 'stagiaire'] as const;
const trier = (a: (typeof tous)[number], b: (typeof tous)[number]) =>
  ordreRole.indexOf(a.data.role) - ordreRole.indexOf(b.data.role) || a.data.ordre - b.data.ordre || a.data.nom.localeCompare(b.data.nom);

const direction = tous.find((m) => m.data.role === 'direction' && m.data.statut === 'actuel');
const actuels = tous.filter((m) => m.data.statut === 'actuel' && m.data.role !== 'direction').sort(trier);
const anciens = tous
  .filter((m) => m.data.statut === 'ancien')
  .sort((a, b) => (b.data.annees ?? '').slice(-4).localeCompare((a.data.annees ?? '').slice(-4)) || trier(a, b));
const roles = ordreRole.filter((r) => r !== 'direction' && actuels.some((m) => m.data.role === r));
const avecBio = await Promise.all(actuels.map(async (m) => ({ m, Bio: m.body?.trim() ? (await render(m)).Content : null })));
const premierParagraphe = direction?.body?.split(/\n\s*\n/)[0]?.trim();
// Portraits associés : A Isabelle (26 oct.), C Léa Moubayed, D Florence Peters, E Alexia Piché, F Dorothée Comtois-Cabana, G Corentin Montiel (28 oct.).
const portraitsAassocier = ['b', 'h'];
const sujetLangue = (s?: string) => (s && !/[éèàçùê]|\b(le|la|les|des|du|et|chez)\b/i.test(s) ? 'en' : undefined);
---

<Base lang={lang} titre={t(lang, 'equipe.titre')} description={t(lang, 'equipe.intro')} section="equipe">
  <header class="cadre entete-page">
    <nav class="fil-ariane" aria-label={t(lang, 'nav.fil')}>
      <ol>
        <li><a href={lien(lang)}>{t(lang, 'nav.accueil')}</a></li>
        <li aria-current="page">{t(lang, 'equipe.titre')}</li>
      </ol>
    </nav>
    <h1>{t(lang, 'equipe.titre')}</h1>
    <p class="chapo">{t(lang, 'equipe.intro')}</p>
    <nav class="ancres" aria-label="Dans cette page">
      <a class="filtre" href="#actuels">{t(lang, 'nav.equipe.actuels')}</a>
      <a class="filtre" href="#diplomes">{t(lang, 'nav.equipe.diplomes')}</a>
      <a class="filtre" href="#etudier">{t(lang, 'nav.equipe.etudier')}</a>
    </nav>
  </header>

  {
    direction && (
      <section class="cadre direction" aria-labelledby="direction">
        <div class="direction__image">
          <Portrait nom={direction.data.nom} photo={direction.data.photo} cadrage={direction.data.cadrage} eager />
          <AValider si={direction.data.a_valider} lang={lang} note="Ce portrait est-il bien celui d'Isabelle? Lequel préfère-t-elle parmi ceux de la séance de 2025?" />
        </div>
        <div class="direction__texte">
          <p class="etiquette">{t(lang, 'equipe.direction')}</p>
          <h2 id="direction">{direction.data.nom}</h2>
          {direction.data.programme && <p class="meta">{direction.data.programme}</p>}
          {premierParagraphe && <p class="direction__bio">{premierParagraphe}</p>}
          <a class="lien-fleche" href={lien(lang, 'le-labo/#direction')}>
            {t(lang, 'equipe.bio')}
            <Icone nom="fleche" />
          </a>
        </div>
      </section>
    )
  }

  <section class="cadre actuels" id="actuels" aria-labelledby="actuels-titre">
    <div class="tete-section actuels__tete">
      <h2 id="actuels-titre">{t(lang, 'equipe.actuels')}</h2>
      <div class="filtres" role="group" aria-label="Filtrer par rôle" data-filtres hidden>
        <button class="filtre" type="button" aria-pressed="true" data-role="">{t(lang, 'equipe.tous')} <span>{actuels.length}</span></button>
        {
          roles.map((r) => (
            <button class="filtre" type="button" aria-pressed="false" data-role={r}>
              {t(lang, `equipe.${r}`)} <span>{actuels.filter((m) => m.data.role === r).length}</span>
            </button>
          ))
        }
      </div>
    </div>
    <ul class="membres">
      {
        avecBio.map(({ m, Bio }) => {
          const d = m.data;
          const aFiche = Boolean(d.programme || d.annees || d.codirection || d.distinctions.length || Bio || (d.sujet && d.sujet.length > 110));
          return (
            <li class="membre" data-role={d.role}>
              <Portrait nom={d.nom} photo={d.photo} cadrage={d.cadrage} />
              <h3 class="membre__nom">{d.nom}</h3>
              <p class="membre__titre">{d.titre}</p>
              {d.sujet && (
                <p class="membre__sujet" lang={sujetLangue(d.sujet)}>
                  {d.sujet}
                </p>
              )}
              {aFiche && (
                <details class="membre__fiche">
                  <summary>
                    {t(lang, 'equipe.fiche')}
                    <span class="visuellement-cache"> : {d.nom}</span>
                    <Icone nom="chevron" taille={14} />
                  </summary>
                  <dl>
                    {d.annees && (
                      <div>
                        <dt>{t(lang, 'equipe.au_labe')}</dt>
                        <dd>{d.annees}</dd>
                      </div>
                    )}
                    {d.programme && (
                      <div>
                        <dt>{t(lang, 'equipe.programme')}</dt>
                        <dd>{d.programme}</dd>
                      </div>
                    )}
                    {d.codirection && (
                      <div>
                        <dt>{t(lang, 'equipe.codirection')}</dt>
                        <dd>{d.codirection}</dd>
                      </div>
                    )}
                    {d.sujet && (
                      <div>
                        <dt>{t(lang, 'equipe.sujet')}</dt>
                        <dd lang={sujetLangue(d.sujet)}>{d.sujet}</dd>
                      </div>
                    )}
                    {d.distinctions.length > 0 && (
                      <div>
                        <dt>{t(lang, 'equipe.distinctions')}</dt>
                        <dd>
                          <ul>
                            {d.distinctions.map((x) => (
                              <li>{x}</li>
                            ))}
                          </ul>
                        </dd>
                      </div>
                    )}
                  </dl>
                  {Bio && (
                    <div class="membre__bio">
                      <Bio />
                    </div>
                  )}
                </details>
              )}
              <AValider si={d.a_valider} lang={lang} class="membre__a-valider" />
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    APERCU && (
      <section class="cadre aassocier" aria-labelledby="aassocier">
        <div class="aassocier__boite">
          <h2 id="aassocier">Portraits de la séance de 2025 à associer</h2>
          <AValider lang={lang} note="Associer les portraits B et H à un nom, et dire qui n'a pas encore de portrait." />
          <p>
            Visible seulement sur la version d'aperçu. Pour chaque lettre, indiquer le nom de la personne : le portrait remplacera alors son
            monogramme.
          </p>
          <ul>
            {portraitsAassocier.map((x) => (
              <li>
                <img src={`/images/equipe/portrait-${x}.webp`} alt={`Portrait ${x.toUpperCase()}, nom à associer`} loading="lazy" />
                <span>Portrait {x.toUpperCase()}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section cadre" id="diplomes" aria-labelledby="diplomes-titre">
    <div class="tete-section">
      <h2 id="diplomes-titre">{t(lang, 'equipe.anciens')}</h2>
      <p class="meta">{t(lang, 'equipe.anciens.intro')}</p>
    </div>
    <div class="tableau">
      <table>
        <thead>
          <tr>
            <th scope="col">{t(lang, 'equipe.nom')}</th>
            <th scope="col">{t(lang, 'equipe.formation')}</th>
            <th scope="col">{t(lang, 'equipe.annees')}</th>
            <th scope="col">{t(lang, 'equipe.sujet')}</th>
          </tr>
        </thead>
        <tbody>
          {
            anciens.map((m) => (
              <tr>
                <th scope="row">
                  {m.data.nom}
                  <AValider si={m.data.a_valider} lang={lang} />
                </th>
                <td>{m.data.titre}</td>
                <td>{m.data.annees?.replace(/\s*–\s*/, '–')}</td>
                <td lang={sujetLangue(m.data.sujet)}>{m.data.sujet}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="cadre" id="etudier" aria-labelledby="etudier-titre">
    <div class="etudier">
      <div>
        <h2 id="etudier-titre">{t(lang, 'equipe.etudier')}</h2>
        <p>{t(lang, 'equipe.etudier.texte')}</p>
      </div>
      <a class="bouton" href="mailto:isabelle.dore@umontreal.ca">{t(lang, 'equipe.etudier.bouton')}</a>
    </div>
  </section>
</Base>

<script>
  const zone = document.querySelector<HTMLElement>('[data-filtres]');
  if (zone) {
    zone.hidden = false;
    const boutons = [...zone.querySelectorAll<HTMLButtonElement>('[data-role]')];
    const membres = [...document.querySelectorAll<HTMLElement>('.membre')];
    boutons.forEach((b) =>
      b.addEventListener('click', () => {
        const role = b.dataset.role ?? '';
        boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        membres.forEach((m) => (m.hidden = Boolean(role) && m.dataset.role !== role));
      }),
    );
  }
</script>

<style>
  .ancres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pas-2);
    margin-top: var(--pas-5);
  }
  .ancres .filtre {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    text-decoration: none;
  }
  .direction {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pas-5);
    row-gap: var(--pas-5);
    align-items: center;
    padding-block: var(--pas-5) clamp(3.5rem, 8vw, 5.5rem);
  }
  .direction__image {
    grid-column: span 4;
  }
  .direction__texte {
    grid-column: 6 / span 7;
  }
  .direction__bio {
    font-size: 1.125rem;
    margin-block: var(--pas-4);
  }
  .actuels {
    padding-bottom: clamp(3.5rem, 8vw, 5.5rem);
  }
  .actuels__tete {
    border-top: 1px solid var(--c-trait);
    padding-top: var(--pas-7);
  }
  .membres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--pas-7) var(--pas-5);
    align-items: start;
  }
  .membre :global(.portrait) {
    margin-bottom: var(--pas-4);
  }
  .membre__nom {
    font-size: 1.15rem;
    margin-bottom: var(--pas-1);
  }
  .membre__titre {
    margin: 0 0 var(--pas-2);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-identite);
  }
  .membre__sujet {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--c-texte-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .membre__fiche {
    margin-top: var(--pas-2);
  }
  .membre__fiche summary {
    display: inline-flex;
    align-items: center;
    gap: var(--pas-2);
    min-height: 2.75rem;
    color: var(--c-action);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .membre__fiche summary::-webkit-details-marker {
    display: none;
  }
  .membre__fiche[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .membre__fiche dl {
    margin: var(--pas-2) 0 0;
    padding: var(--pas-4);
    border-radius: var(--rayon);
    background: var(--c-surface);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .membre__fiche dl > div + div {
    margin-top: var(--pas-3);
  }
  .membre__fiche dt {
    font-weight: 600;
    color: var(--c-titre);
  }
  .membre__fiche dd {
    margin: 0;
    color: var(--c-texte-2);
  }
  .membre__fiche dd ul {
    margin: 0;
    padding-left: 1.1em;
  }
  .membre__bio {
    margin-top: var(--pas-3);
    font-size: 0.9375rem;
  }
  .aassocier__boite {
    padding: var(--pas-6);
    border: 2px dashed #8a5a00;
    border-radius: var(--rayon);
    background: #fffaf0;
  }
  .aassocier h2 {
    font-size: 1.6rem;
  }
  .aassocier ul {
    list-style: none;
    margin: var(--pas-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--pas-3);
  }
  .aassocier img {
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: var(--rayon-petit);
  }
  .aassocier span {
    display: block;
    margin-top: var(--pas-1);
    font-weight: 700;
    font-size: 0.875rem;
  }
  .tableau {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.5;
  }
  thead th {
    text-align: left;
    padding: var(--pas-3) var(--pas-4) var(--pas-3) 0;
    border-bottom: 2px solid var(--c-titre);
    font-family: var(--f-majuscules);
    font-size: 0.8125rem;
    font-weight: 600;
    font-stretch: 115%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-titre);
  }
  tbody th,
  tbody td {
    text-align: left;
    vertical-align: top;
    padding: var(--pas-4) var(--pas-4) var(--pas-4) 0;
    border-bottom: 1px solid var(--c-trait);
  }
  tbody th {
    font-weight: 600;
    color: var(--c-titre);
    width: 24%;
  }
  tbody td {
    color: var(--c-texte-2);
  }
  tbody td:nth-child(3) {
    white-space: nowrap;
  }
  .etudier {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pas-5) var(--pas-7);
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: var(--rayon);
    background: var(--c-surface-2);
  }
  .etudier > div {
    flex: 1 1 32rem;
  }
  .etudier p {
    margin: 0;
    font-size: 1.125rem;
  }
  @media (max-width: 64em) {
    .membres {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .aassocier ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 54em) {
    .direction__image,
    .direction__texte {
      grid-column: 1 / -1;
    }
    .direction__image {
      max-width: 20rem;
    }
    .membres {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--pas-6) var(--pas-4);
    }
  }
</style>
