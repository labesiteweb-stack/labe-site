---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { t } from '../i18n/ui';
import { APERCU } from '../lib/contenu';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import Commentaires from '../components/Commentaires.astro';

interface Props {
  lang: string;
  titre?: string;
  description?: string;
  image?: string;
  section?: 'labo' | 'projets' | 'equipe' | 'publications' | 'nouvelles' | 'contact';
}

const { lang, titre, description, image, section } = Astro.props;
const site = (await getEntry('reglages', 'site'))!.data;
const titreComplet = titre ? `${titre} | ${site.sigle}` : `${site.sigle}, ${site.nom}`;
const desc =
  description ??
  "Le LABE, à l'Université de Montréal et au CRCHUM, étudie comment l'activité physique favorise la santé mentale et le bien-être.";
const canonique = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image ?? '/images/accueil/hero-jardin.webp', Astro.site)} />
    <meta name="theme-color" content="#3a5741" />
    {APERCU && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="evitement" href="#contenu">{t(lang, 'lien.evitement')}</a>
    {
      APERCU && (
        <div class="apercu" data-apercu>
          <div class="cadre apercu__rang">
            <p class="apercu__texte">{t(lang, 'apercu.bandeau')}</p>
            <Commentaires lang={lang} />
          </div>
        </div>
      )
    }
    <Entete lang={lang} section={section} />

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <Pied lang={lang} />
  </body>
</html>

<style>
  .evitement {
    position: absolute;
    left: var(--pas-4);
    top: -5rem;
    z-index: 50;
    padding: var(--pas-3) var(--pas-4);
    border-radius: var(--rayon-petit);
    background: var(--c-action);
    color: var(--c-sur-action);
    font-weight: 600;
  }
  .evitement:focus {
    top: var(--pas-3);
  }
  main:focus {
    outline: none;
  }
  .apercu {
    background: #fff4d6;
    border-bottom: 1px solid #e6cf8f;
    color: #3d2a00;
    font-size: 0.875rem;
  }
  .apercu__rang {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--pas-2) var(--pas-5);
    padding-block: var(--pas-2);
  }
  .apercu__texte {
    margin: 0;
  }
</style>
